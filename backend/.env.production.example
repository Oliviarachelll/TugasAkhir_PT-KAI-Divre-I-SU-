# ============================================================
# DASHKAI OPERATIONAL REPORTING SYSTEM — PRODUCTION ENVIRONMENT
# PT Kereta Api Indonesia (Persero) Divisi Regional I SU
# ============================================================

# Application Runtime
NODE_ENV=production
PORT=5050

# Database (MySQL 8 on Tencent Cloud Lighthouse VPS)
# Catatan: Simbol '#' pada password di-encode menjadi '%23'
DATABASE_URL="mysql://lucky:Ulangandadakan2%23@localhost:3306/dashkai_db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_dashkai_kai_divre1_production_2026_xyz
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# CORS & Domain Policy
# Ubah nilai di bawah sesuai dengan nama domain yang Anda gunakan (contoh: https://dashkai.com atau https://domainanda.com)
CORS_ORIGIN=*

# WhatsApp Notifications (Baileys)
ENABLE_WHATSAPP=true
WA_SESSION_PATH=/var/www/dashkai/shared/whatsapp-session
WA_DELAY_MS=2000

# Puppeteer PDF Rendering on Ubuntu VPS (Headless Mode)
PUPPETEER_NO_SANDBOX=true
