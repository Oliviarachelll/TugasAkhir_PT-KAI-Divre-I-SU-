# ============================================================
# RACHE OPERATIONAL REPORTING SYSTEM — PRODUCTION ENVIRONMENT
# ============================================================

# Application Runtime
NODE_ENV=production
PORT=5050

# Database (MySQL 8 on Tencent Cloud Lighthouse VPS)
# Catatan: Simbol '#' pada password di-encode menjadi '%23'
DATABASE_URL="mysql://lucky:Ulangandadakan2%23@localhost:3306/rache_db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_rache_kai_divre1_production_2026_xyz
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# CORS & Domain Policy
CORS_ORIGIN=https://rache.us.ci

# WhatsApp Notifications (Baileys)
ENABLE_WHATSAPP=true
WA_SESSION_PATH=/var/www/rache/shared/whatsapp-session
WA_DELAY_MS=2000

# Puppeteer PDF Rendering on Ubuntu VPS (Headless Mode)
PUPPETEER_NO_SANDBOX=true
