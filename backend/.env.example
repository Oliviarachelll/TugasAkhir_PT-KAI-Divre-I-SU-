# ========================
# APPLICATION
# ========================
NODE_ENV=development
PORT=5000

# ========================
# DATABASE
# ========================
DATABASE_URL="mysql://root:password@localhost:3306/rache_db"

# ========================
# JWT
# ========================
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ========================
# BCRYPT
# ========================
BCRYPT_ROUNDS=12

# ========================
# CORS
# ========================
CORS_ORIGIN=http://localhost:3000

# ========================
# WHATSAPP (Baileys)
# ========================
WA_SESSION_PATH=./whatsapp-session

# ========================
# META WA CLOUD API
# ========================
META_WA_ACCESS_TOKEN=your_meta_access_token_here
META_WA_PHONE_NUMBER_ID=your_phone_number_id_here
META_WA_API_VERSION=v20.0
